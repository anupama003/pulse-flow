# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulse_flow

# AI provider: "gemini" or "anthropic". Leave empty to auto-pick (Gemini if only GEMINI_API_KEY is set).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Model for handover, rounds and e-prescriptions
GEMINI_MODEL=gemini-3.8-flash
# Faster model for patient booking and walk-in intake
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Links in WhatsApp messages (Rx PDF). Set a long random secret in production.
PUBLIC_BASE_URL=http://localhost:3000
LINK_SIGNING_SECRET=

# WhatsApp: leave WHATSAPP_PROVIDER empty for DRY_RUN (payloads are built + logged, not sent)
# meta | twilio
WHATSAPP_PROVIDER=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v21.0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_CONTENT_SID_APPOINTMENT_TOKEN=
TWILIO_CONTENT_SID_RX_DOCUMENT=
TWILIO_CONTENT_SID_FOLLOW_UP=

# Switch (team-chat rooms for the Pulse Flow agents): leave empty to SIMULATE room posts (shown in /audit)
SWITCH_URL=
SWITCH_REGISTRATION_KEY=
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=
SWITCH_ROOM_WARD=
SWITCH_ROOM_ESCALATIONS=
SWITCH_ROOM_OPD=
SWITCH_ROOM_FULFILMENT=
# The ward coordinator agent's name (your template's team + -ward-coordinator); npm run switch:nudge wakes it
SWITCH_COORDINATOR_AGENT=lotus-ward-coordinator
# Map chat handles to staff ids when they don't match staff names, e.g. anupama=u-menon,night-pg=u-rahul
PULSE_FLOW_CHAT_HANDLES=

{
  "name": "pulse-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env --conditions=react-server prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:studio": "prisma studio",
    "test:rules": "tsx --conditions=react-server scripts/validate-cases.ts && tsx --conditions=react-server scripts/opd-cases.ts",
    "test:db": "tsx --env-file=.env --conditions=react-server scripts/db-smoke.ts",
    "test": "npm run typecheck && npm run test:rules && npm run test:switch",
    "setup": "node scripts/setup.mjs",
    "switch:setup": "tsx switch/setup.ts",
    "switch:register": "tsx --env-file=.env switch/register.ts",
    "switch:mcp": "tsx --env-file=.env --conditions=react-server switch/mcp/server.ts",
    "test:agents": "tsx --env-file=.env --conditions=react-server scripts/agent-smoke.ts",
    "test:switch": "tsx --conditions=react-server scripts/switch-cases.ts",
    "switch:templates": "tsx switch/telegram-template.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.32.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/client": "^6.19.3",
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.63.0",
    "next": "^15.5.28",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "description": "Pulse Flow: voice-first hospital & clinic platform (IPD handovers, OPD booking, e-Rx, pharmacy, lab, WhatsApp)",
  "engines": {
    "node": ">=20.11"
  }
}
